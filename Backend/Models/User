const mongoose = require("mongoose");
const bcrypt = require("bcryptjs");

const userSchema = new mongoose.Schema(
  {
    name: {
      type: String,
      required: true,
      trim: true,
    },

    username: {
      type: String,
      required: true,
      unique: true,
      trim: true,
      minlength: 3,
    },

    email: {
      type: String,
      required: true,
      unique: true,
      lowercase: true,
    },

    password: {
      type: String,
      required: true,
      minlength: 8,
    },

    phone: {
      type: String,
    },

    address: {
      type: String,
    },

    role: {
      type: String,
      enum: ["student", "host", "admin"],
      default: "student",
    },

    profileImage: {
      type: String,
    },

    about: {
      type: String,
    },

    languages: [String],

    interests: [String],

    favorites: [
      {
        type: mongoose.Schema.Types.ObjectId,
        ref: "Accommodation",
      },
    ],

    reviews: [
      {
        type: mongoose.Schema.Types.ObjectId,
        ref: "Review",
      },
    ],

    stats: {
      totalReviews: { type: Number, default: 0 },
      hostSince: { type: Date },
      hostRating: { type: Number, default: 0 },
    },

    isVerified: {
      email: { type: Boolean, default: false },
      phone: { type: Boolean, default: false },
      id: { type: Boolean, default: false },
    },

    // OTP fields
    otp: {
      code: { type: String },
      expiresAt: { type: Date },
    },
  },
  {
    timestamps: true,
  }
);

// Hash password before saving
userSchema.pre("save", async function () {
  if (!this.isModified("password")) return;

  const salt = await bcrypt.genSalt(10);
  this.password = await bcrypt.hash(this.password, salt);
});

module.exports = mongoose.models.User || mongoose.model("User", userSchema);